@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var homeActive = currentController == "Home" && currentAction == "Index" ? " active" : string.Empty;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 後端工程師議題管理系統</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="sidebar-title">後端工程師議題管理系統</div>
            <div class="sidebar-subtitle">Backend Engineer Issue Management System</div>
        </div>
        <nav class="sidebar-nav">
            <a class="sidebar-link@homeActive" asp-area="" asp-controller="Home" asp-action="Index">首頁</a>
            <span class="sidebar-link sidebar-link-disabled" title="尚未開放" aria-disabled="true">議題管理</span>
        </nav>
    </aside>
    <main class="content" role="main">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
