@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登入 - 後端工程師議題管理系統</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-container">
        <section class="login-card" aria-labelledby="login-title">
            <header class="login-header">
                <h1 id="login-title" class="login-title">後端工程師議題管理系統</h1>
                <p class="login-subtitle">Backend Engineer Issue Management System</p>
            </header>

            <form class="login-form" method="post">
                <div class="form-group">
                    <label class="form-label" for="username">帳號</label>
                    <input class="form-input" type="text" id="username" name="username"
                           placeholder="請輸入帳號" autocomplete="username" autofocus />
                </div>

                <div class="form-group">
                    <label class="form-label" for="password">密碼</label>
                    <input class="form-input" type="password" id="password" name="password"
                           placeholder="請輸入密碼" autocomplete="current-password" />
                </div>

                <button type="button" class="login-button">登入</button>
            </form>
        </section>
    </main>
</body>
</html>
